# Copy this file to .env.local and fill in your own values.
# .env.local is gitignored — never commit real keys.

# ── Watson.ai (IBM watsonx.ai) — primary LLM for filemap + explain-code ───────
# Sign up at: https://www.ibm.com/watsonx
# API key:    IBM Cloud console → Manage → Access (IAM) → API keys
# URL:        Regional endpoint, e.g. https://us-south.ml.cloud.ibm.com
# Project ID: watsonx.ai console → your project → Manage → General → Project ID
WATSONX_API_KEY=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_PROJECT_ID=
# Optional — defaults to meta-llama/llama-3-3-70b-instruct
# WATSONX_MODEL_ID=meta-llama/llama-3-3-70b-instruct

# ── Groq AI — fallback LLM (used when Watson.ai is unavailable) ───────────────
# Get a free key at: https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL_ORCHESTRATOR=openai/gpt-oss-120b
GROQ_MODEL_UI=openai/gpt-oss-120b
GROQ_MODEL_REVIEW=openai/gpt-oss-20b
GROQ_MODEL_FILEMAP=openai/gpt-oss-20b
GROQ_MODEL=openai/gpt-oss-20b

# ── GitHub OAuth ──────────────────────────────────────────────────────────────
# Create an OAuth App at: https://github.com/settings/developers
#   Homepage URL:    http://localhost:3000
#   Callback URL:    http://localhost:3000/api/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Session secret ────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=
AUTH_TRUST_HOST=true

# ── Optional: GitHub PAT for higher API rate limits (unauthenticated visitors) ─
# https://github.com/settings/tokens — scopes: Contents (read), Metadata (read)
# GITHUB_TOKEN=
